# Neon PostgreSQL connection string (use the POOLED connection string from Neon dashboard)
DATABASE_URI=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Used to encrypt JWT tokens — must be a random string of 32+ characters
PAYLOAD_SECRET=GENERATE_A_STRONG_SECRET_HERE

# Your production URL. No trailing slash. Used for CORS, sitemaps, and Open Graph links.
NEXT_PUBLIC_SERVER_URL=https://your-domain.vercel.app

# Vercel Blob token — create a Blob store in your Vercel project → Storage → Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXX

# Secret used to authenticate cron jobs
CRON_SECRET=GENERATE_A_RANDOM_SECRET_HERE

# Used to validate live-preview requests
PREVIEW_SECRET=GENERATE_A_RANDOM_SECRET_HERE

# Google Analytics 4 Measurement ID (GA4 property → Data Streams)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
